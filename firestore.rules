rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleção de usuários: cada usuário gerencia apenas seu próprio perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Coleção de QR Codes Dinâmicos
    match /dynamicQRCodes/{qrId} {
      // Leitura pública permitida para o redirecionamento imediato (/q/:slug)
      allow read: if true;

      // Criação permitida se o userId pertencer ao usuário autenticado
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Edição pelo proprietário OU incremento de leitura (scansCount/lastScanAt) ao escanear
      allow update: if (
        request.auth != null && resource.data.userId == request.auth.uid
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scansCount', 'lastScanAt'])
      );

      // Exclusão permitida apenas pelo proprietário
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Coleção de Lotes de QR Codes em Massa
    match /qrBatches/{batchId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // Coleção de Empresas Google Avaliações (Minhas Empresas)
    match /googleBusinesses/{businessId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // Coleção de Histórico de Impressão de Plaquinhas
    match /printJobs/{jobId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }
  }
}
